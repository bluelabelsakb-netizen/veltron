# --- Veltron sunucu ayarlari -----------------------------------------
# Bu dosyayi ".env" adıyla kopyalayıp degerleri kendi ortamınıza gore duzenleyin.

# Sunucu dinleyeceği adres ve port
# 0.0.0.0 = yerel agdaki tum bilgisayarlar erisebilir (ekip icin gerekli)
HOST=0.0.0.0
PORT=4000

# Veritabani dosyasi (varsayilan: server/data/veltron.db)
# DB_FILE=C:\Veltron\veri\veltron.db

# Oturum imzalama anahtari - MUTLAKA degistirin!
# Rastgele uretmek icin:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=degistirin-bu-anahtari

# Oturum gecerlilik suresi
TOKEN_TTL=12h

# Ilk acilista olusacak yonetici hesabi
# Kullanici sayisi 0 ise bu bilgilerle yonetici olusur.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=veltron123
ADMIN_NAME=Sistem Yöneticisi


# Tarayici tabanli erisim icin izin verilen kaynaklar (virgulle ayirilir).
# GUVENLIK: Internete acikken (AILE-ERISIMI.bat ile aile erisimi) yildiz
# kullanmayin - yalnizca kendi adreslerinizi yazin.
# Electron masaustu modu Origin gondermez, her zaman serbesttir.
CORS_ORIGIN=http://localhost:4000,http://127.0.0.1:4000,http://192.168.1.100:4000,https://localhost:4000

# --- MUSTERI PORTALI HESAPLARI ---------------------------------------------
# Veritabanina musteri portali hesabi acar (vuruskan / vuruskan-mali).
# Bos birakilirsa hicbir musteri hesabi olusmaz.
PORTAL_PASSWORD_PROGRESS=
PORTAL_PASSWORD_FINANCE=

# --- YONETICIYE BILDIRIM (Telegram) ---------------------------------------
# Sifre sifirlama talebi gelince yoneticiye mesaj gider.
#
# KURULUM (2 dakika):
#   1) Telegram'da @BotFather'a yaz, /newbot komutu, token al
#   2) Botu ac ve /start yaz      <-- SART, yoksa sana mesaj atamaz
#   3) Tarayicida ac:  https://api.telegram.org/bot<TOKEN>/getUpdates
#      "chat":{"id": 123456789}  -> bu sayi CHAT_ID
#   4) Asagidaki iki satiri doldur, sunucuyu yeniden baslat
#
# BOS BIRAKILIRSA: bildirim gonderilmez ama sistem CALISIR. Talep
# veritabaninda bekler, yonetici "Yonetim > Sifre Talepleri" ekraninda gorur.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
